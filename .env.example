# Anthropic API (resume analysis + job scoring)
ANTHROPIC_API_KEY=

# Optional: override the default model
# CLAUDE_MODEL=claude-sonnet-5

# JSearch via RapidAPI (aggregates LinkedIn/Indeed/Glassdoor/ZipRecruiter/Monster)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna API (secondary job source)
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Hugging Face Hub dataset repo used as shared persistent storage between the
# Gradio Space and the GitHub Actions daily job. Create a (private) dataset
# repo at https://huggingface.co/new-dataset and put its id here, e.g.
# "your-username/job-hunt-agent-data". HF_TOKEN needs write access to it.
HF_TOKEN=
HF_DATASET_REPO=

# Optional tuning
# DAILY_JOB_COUNT=30
# SEEN_JOB_MEMORY_DAYS=45
